# Copy to .env and fill values. Never commit real secrets.

# --- Core ---
MONGO_URI=mongodb://localhost:27017/
SECRET_KEY=change-me
PORT=8000

# --- Enrichment ---
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
GOOGLE_PLACES_API_KEY=

# --- Pipedrive import service ---
ENABLE_PIPEDRIVE_IMPORT=false
PIPEDRIVE_APP_BASE_URL=
PIPEDRIVE_APP_USERNAME=
PIPEDRIVE_APP_PASSWORD=
# When true, Excel headers use custom-field API keys instead of human names
PIPEDRIVE_EXPORT_USE_API_KEYS=false
# Optional JSON overrides (defaults to config/pipedrive_field_keys.json)
PIPEDRIVE_FIELD_KEYS_FILE=

# §5.1 / §7 item 2 — Pipedrive custom field API keys (hashes)
PIPEDRIVE_FIELD_ORGANIZATION=
PIPEDRIVE_FIELD_ADDRESS=
PIPEDRIVE_FIELD_ZIP=
PIPEDRIVE_FIELD_CITY=
PIPEDRIVE_FIELD_CANTON=
PIPEDRIVE_FIELD_PHONE=
PIPEDRIVE_FIELD_MOBILE=
PIPEDRIVE_FIELD_EMAIL=
PIPEDRIVE_FIELD_WEBSITE=
PIPEDRIVE_FIELD_MONEYHOUSE_URL=
PIPEDRIVE_FIELD_GMB_URL=
PIPEDRIVE_FIELD_GMB_RATING=
PIPEDRIVE_FIELD_GMB_REVIEWS=
PIPEDRIVE_FIELD_LOCAL_SEARCH=
PIPEDRIVE_FIELD_BANNER_ADS=
PIPEDRIVE_FIELD_WEB_BANNER_ADS=
PIPEDRIVE_FIELD_YELLOW_RATED=
PIPEDRIVE_FIELD_ROBOT_FLAGS=
PIPEDRIVE_FIELD_CREDIBILITY_SCORE=
PIPEDRIVE_FIELD_SCORE_MODEL=
PIPEDRIVE_FIELD_COPYRIGHT_YEAR=
PIPEDRIVE_FIELD_LOCALCH_URL=
PIPEDRIVE_FIELD_KEYWORD=

# --- §6 IP rotation / proxy pool ---
# Comma or newline separated. Examples:
#   http://1.2.3.4:8080
#   http://user:pass@1.2.3.4:8080
#   socks5://1.2.3.4:1080
PROXY_URLS=
PROXY_LIST_FILE=
PROXY_ROTATION=true

# --- Scraper ---
SCRAPER_HEADED=false
SCRAPER_DEBUG_MODE=false
SCRAPER_SAVE_DEBUG_ARTIFACTS=false
